# CrowdSec bouncer -- blocks IPs flagged by CrowdSec detection engine.
# API key is container-internal only (CrowdSec LAPI on Docker network).
# Regenerate: docker exec proxy-crowdsec-1 cscli bouncers add traefik-bouncer -o raw
# This file is generated by deploy.ps1 from crowdsec.yml.template + proxy/.env
# Do NOT edit directly -- edit the template instead.
http:
  middlewares:
    crowdsec-bouncer:
      plugin:
        crowdsec:
          crowdseclapikey: "{{CROWDSEC_API_KEY}}"
          crowdseclapihost: "proxy-crowdsec-1:8080"
          crowdsecmode: stream
          updateintervalSeconds: 15
