# Simple nginx image with pre-built Expo web bundle
# Usage: build dist locally first, then: docker build -f Dockerfile.prebuilt -t luma/web:latest ../../../
FROM nginx:1.27-alpine

COPY infra/proxy/luma-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY luma-app/dist /usr/share/nginx/html

RUN echo "ok" > /usr/share/nginx/html/healthz

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1
