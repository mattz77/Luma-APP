{
  "expo": {
    "name": "Luma",
    "slug": "luma-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/luma-icon.png",
    "scheme": "lumaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/luma-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicebytesolutions.lumaapp"
    },
    "android": {
      "package": "com.nicebytesolutions.lumaapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/luma-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/luma-icon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "nicebytesolutions",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/70b6b180-a3d9-4d77-872a-9a339f29ba43"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70b6b180-a3d9-4d77-872a-9a339f29ba43"
      }
    }
  }
}
