    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.output || '').toString();\n// Remove function-call leftovers\nlet clean = raw.replace(/<function[^>]*>.*?<\\/function>/gis, '');\nclean = clean.replace(/\\{[^}]*\"input\"[^}]*\\}/gi, '');\nclean = clean.replace(/\\s+/g, ' ').trim();\nclean = clean.replace(/\\s+([.,!?])/g, '$1');\nif (!clean || clean.length < 2) clean = raw;\n// Detecta delegação inválida do specialist\nif (/DELEGATE:OUT_OF_DOMAIN/i.test(clean)) {\n  clean = 'Posso ajudar com tarefas, finanças, gestão da casa e perfil. Para outros assuntos, prefiro não responder para manter o foco. 😊';\n}\nconst ctx = $('Extract Context').item.json;\nreturn { json: { success: true, response: clean, metadata: { session_id: ctx.session_id, intent: $('Normalize Intent').item.json.intent, message_id: ctx.message_id, model: 'llama3.1:8b' } } };"
      },
      "id": "clean-response",
      "name": "Clean Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2300, 800]
    },

