    {
      "parameters": {
        "promptType": "define",
        "text": "=Mensagem do usuário: \"{{ $json.message }}\"\n\nClassifique a intenção em UMA das categorias abaixo. Responda APENAS o token, sem texto adicional:\n\n- TASKS      (criar/listar/concluir tarefa, lembrete, atribuir)\n- FINANCES   (despesa, gasto, valor R$, orçamento, conta, fatura)\n- HOUSE      (membros da casa, papéis, quem mora)\n- PROFILE    (perfil, idade, conquistas, XP, nível, gamificação)\n- GENERAL    (saudação, dúvida sobre o app, ajuda genérica sobre a Luma)\n- OUT_OF_SCOPE (qualquer coisa fora de gestão de casa: política, código, receitas, notícias, piadas, conversa aleatória)\n\nResposta:",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "Você é um classificador de intenções da Luma, assistente exclusiva de gestão doméstica. Sua única tarefa é retornar UM dos tokens listados. Nunca responda outra coisa."
        }
      },
      "id": "classifier-agent",
      "name": "Classify Intent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [800, 400]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza saída do classifier para tokens válidos\nconst raw = ($input.first().json.output || '').toString().toUpperCase().trim();\nconst valid = ['TASKS','FINANCES','HOUSE','PROFILE','GENERAL','OUT_OF_SCOPE'];\nconst found = valid.find(v => raw.includes(v)) || 'OUT_OF_SCOPE';\nconst ctx = $('Extract Context').item.json;\nreturn { json: { ...ctx, intent: found } };"
      },
      "id": "normalize-intent",
      "name": "Normalize Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "id": "r1", "leftValue": "={{ $json.intent }}", "rightValue": "TASKS",    "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "tasks" },
            { "conditions": { "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "id": "r2", "leftValue": "={{ $json.intent }}", "rightValue": "FINANCES", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "finances" },
            { "conditions": { "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "id": "r3", "leftValue": "={{ $json.intent }}", "rightValue": "HOUSE",    "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "house" },
            { "conditions": { "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "id": "r4", "leftValue": "={{ $json.intent }}", "rightValue": "PROFILE",  "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "profile" },
            { "conditions": { "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "id": "r5", "leftValue": "={{ $json.intent }}", "rightValue": "GENERAL",  "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "general" }
          ]
        },
        "fallbackOutput": "extra",
        "options": { "renameFallbackOutput": "out_of_scope" }
      },
      "id": "switch-intent",
      "name": "Route by Intent",
      "type": "n8n-nodes-base.switch",
