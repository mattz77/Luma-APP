{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=YOUR_SUPABASE_PROJECT_REF"
    },
    "n8n-mcp": {
      "command": "npx",
      "args": ["-y", "n8n-mcp@2.49.0"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": "REPLACE_WITH_N8N_PUBLIC_API_JWT"
      }
    },
    "n8n-server": {
      "type": "http",
      "url": "http://localhost:5678/mcp-server/http",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_N8N_MCP_SERVER_JWT"
      }
    }
  }
}
